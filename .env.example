# Copie a .env y genere secretos con:  python -m app.cli generate-keys
GUARDIAN_ENV=development
GUARDIAN_JWT_SECRET=
GUARDIAN_KEYRING=
GUARDIAN_ACTIVE_KEY_VERSION=v1
GUARDIAN_DATABASE_URL=sqlite:///./guardian.db
# GUARDIAN_CORS_ORIGINS=https://consola.midominio.co
# GUARDIAN_ANTHROPIC_API_KEY=
# GUARDIAN_HIBP_ENABLED=true
GUARDIAN_VAULT_DIR=./data/vault
GUARDIAN_BACKUP_DIR=./data/backups

# --- Asistente de IA (elija UNA opción) ---
# A) Anthropic (nube, de pago por uso): https://console.anthropic.com
# GUARDIAN_ANTHROPIC_API_KEY=sk-ant-...
# GUARDIAN_ANTHROPIC_MODEL=claude-sonnet-5
# B) Modelo local con Ollama (gratis, sin clave, los datos no salen del equipo): https://ollama.com
# GUARDIAN_LLM_PROVIDER=openai
# GUARDIAN_LLM_BASE_URL=http://localhost:11434/v1
# GUARDIAN_LLM_MODEL=llama3.1:8b
# GUARDIAN_WEB_BROWSING_ENABLED=true

# ── v4.1: asistente sin estancamientos ─────────────────────────────────────────
# Espera máxima por respuesta del modelo (el código usa al menos 300 s aunque ponga menos).
GUARDIAN_LLM_TIMEOUT_SECONDS=600
# Tope de tokens por respuesta (el asistente continúa solo si aun así se corta).
GUARDIAN_LLM_MAX_TOKENS=16000
# Páginas mínimas de todo documento que cree el asistente (si no pide otra cantidad).
# 0 = automático (cada trabajo recibe la extensión que necesita). Un número fuerza ese mínimo.
GUARDIAN_DOC_MIN_PAGINAS=0
# Con Ollama, suba la ventana de contexto o las respuestas largas se truncan:
#   OLLAMA_CONTEXT_LENGTH=32768   (variable de entorno del servidor de Ollama)

# ── v4.2: velocidad con modelo local ───────────────────────────────────────────
# Con Ollama en un equipo sin GPU el tiempo se va en procesar el prompt: estos valores lo recortan.
# GUARDIAN_LLM_HISTORY_CHARS_LOCAL=12000     (historial que se envía al modelo local)
# GUARDIAN_SKILLS_CHARS_LOCAL=3500           (skills que entran por respuesta con modelo local)
# GUARDIAN_LLM_CONTINUATIONS_LOCAL=2         (veces que continúa solo una respuesta cortada)
# GUARDIAN_DOC_DIRECTO_MARKDOWN=true         (documentos con modelo local: una sola llamada, sin intento en JSON)
# GUARDIAN_RESPUESTA_RAPIDA_ARCHIVO=true     (aviso «archivo listo» por plantilla, sin otra llamada al modelo)
# Para Ollama (variables de SU servidor, no de GuardianIA): OLLAMA_KEEP_ALIVE=30m  OLLAMA_NUM_PARALLEL=2
# Tamaño máximo de un adjunto del chat (fotos, videos, ZIP), en MB
GUARDIAN_ADJUNTO_MAX_MB=4096
